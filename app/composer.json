{
    "name": "ahadmart/ahadpos3",
    "description": "Sistem POS (Point Of Sales) dan Persediaan (Inventory). Berbentuk aplikasi berbasis Web dan Open Source. Menggunakan PHP dan MySql. Mudah digunakan. Kompatibel dengan hardware POS, seperti barcode scanner, printer kasir (auto cutter) (Epson ECP/POS Compatible), & cash drawer",
    "type": "project",
    "require": {
        "yiisoft/yii": "^1.1",
        "mpdf/mpdf": "v8.1.3",
        "cboden/ratchet": "0.4.4",
        "phrity/websocket": "2.2",
        "imagine/imagine": "1.3",
        "ircmaxell/password-compat": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Ahadmart\\Ahadpos3\\": "src/",
            "Yiisoft\\yii\\": "vendor/yiisoft/yii/framework"
        },
        "classmap":[
            "src/protected/migrations/",
            "src/protected/models/",
            "src/protected/commands/",
            "src/protected/components/",
            "src/protected/ws/",
            "src/protected/extensions/",
            "src/protected/controllers/",
            "src/protected/controllers/tools/",
            "src/protected/tests/"
        ]       
    },
    "authors": [
        {
            "name": "Abu Muhammad",
            "email": "b.hermianto@gmail.com"
        }
    ]
}
